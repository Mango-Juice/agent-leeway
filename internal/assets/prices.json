 "caching": {
  "claude": "Claude Code records each cache write as ephemeral_5m_input_tokens or ephemeral_1h_input_tokens; each is priced at its own rate, and the cache of that thread is treated as expiring after that lifetime. Older logs without the split: 1 hour for the main conversation, 5 minutes for sub-agents (Claude Code's subscription defaults).",
  "claude_source": "https://code.claude.com/docs/en/prompt-caching.md",
  "openai": "GPT-5.6 and later keep the prompt cache at least 30 minutes and bill cache writes at the 30-minute rate; earlier models keep it about 5 to 10 minutes and do not bill writes.",
  "openai_source": "https://developers.openai.com/api/docs/guides/prompt-caching"
 },
